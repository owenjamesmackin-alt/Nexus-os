#!/bin/bash
# NEXUS Theme Studio (CLI): list / apply / current / export / import themes.
# A theme is a tiny shell file in /etc/nexus/themes or ~/.config/nexus/themes.
set -eu

NEXUS_ETC="${NEXUS_ETC:-/etc/nexus}"
NEXUS_SHARE="${NEXUS_SHARE:-/usr/share/nexus}"
SYS_THEMES="$NEXUS_ETC/themes"
CFG="$HOME/.config/nexus"
USR_THEMES="$CFG/themes"

find_theme() {
  local d
  for d in "$USR_THEMES" "$SYS_THEMES"; do
    [ -f "$d/$1.conf" ] && { echo "$d/$1.conf"; return 0; }
  done
  return 1
}

list_themes() {
  local d f n
  for d in "$SYS_THEMES" "$USR_THEMES"; do
    [ -d "$d" ] || continue
    for f in "$d"/*.conf; do
      [ -f "$f" ] || continue
      n=$(basename "$f" .conf)
      ( . "$f"; printf '  %-10s %s\n' "$n" "${NAME:-$n}" )
    done
  done
}

apply_theme() {
  local name="$1" f
  f=$(find_theme "$name") || { echo "unknown theme: $name (try: nexus theme list)" >&2; exit 1; }
  # shellcheck disable=SC1090
  . "$f"
  : "${BG:=#07080f}" "${BG2:=#0e1124}" "${FG:=#d6e4ff}" "${ACCENT:=#00b4ff}" "${ACCENT2:=#8a2cff}" "${DIM:=#4a4f7a}"

  mkdir -p "$CFG" "$HOME/.themes/NEXUS/openbox-3" "$HOME/.config/tint2"

  cat > "$CFG/theme.sh" <<EOF
BG='$BG'
BG2='$BG2'
FG='$FG'
ACCENT='$ACCENT'
ACCENT2='$ACCENT2'
DIM='$DIM'
EOF
  echo "$name" > "$CFG/theme"

  # --- terminal (xterm) ---
  cat > "$HOME/.Xresources" <<EOF
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 11
XTerm*renderFont: true
XTerm*background: $BG
XTerm*foreground: $FG
XTerm*cursorColor: $ACCENT
XTerm*pointerColor: $ACCENT
XTerm*scrollBar: false
XTerm*saveLines: 10000
XTerm*selectToClipboard: true
XTerm*internalBorder: 8
XTerm*color0: $BG2
XTerm*color1: #ff5c7a
XTerm*color2: #46e6a6
XTerm*color3: #ffd166
XTerm*color4: $ACCENT
XTerm*color5: $ACCENT2
XTerm*color6: #4de1ff
XTerm*color7: $FG
XTerm*color8: $DIM
XTerm*color9: #ff8aa0
XTerm*color10: #7dffc6
XTerm*color11: #ffe29a
XTerm*color12: $ACCENT
XTerm*color13: $ACCENT2
XTerm*color14: #8aeaff
XTerm*color15: #ffffff
EOF

  # --- window manager theme (Openbox) ---
  cat > "$HOME/.themes/NEXUS/openbox-3/themerc" <<EOF
border.width: 1
padding.width: 6
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
menu.overlap: 0
menu.border.width: 1
menu.border.color: $ACCENT
menu.title.bg: flat solid
menu.title.bg.color: $ACCENT2
menu.title.text.color: #ffffff
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: $BG2
menu.items.text.color: $FG
menu.items.disabled.text.color: $DIM
menu.items.active.bg: flat solid
menu.items.active.bg.color: $ACCENT2
menu.items.active.text.color: #ffffff
window.active.border.color: $ACCENT
window.inactive.border.color: $DIM
window.active.title.bg: flat solid
window.active.title.bg.color: $BG2
window.active.title.separator.color: $ACCENT
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: $BG
window.inactive.title.separator.color: $DIM
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: $FG
window.inactive.label.text.color: $DIM
window.label.text.justify: left
window.active.handle.bg: flat solid
window.active.handle.bg.color: $BG2
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: $BG
window.active.grip.bg: flat solid
window.active.grip.bg.color: $BG2
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: $BG
window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: $BG2
window.active.button.unpressed.image.color: $FG
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: $ACCENT2
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: $ACCENT
window.active.button.pressed.image.color: #ffffff
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: $BG
window.inactive.button.unpressed.image.color: $DIM
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: $BG2
window.inactive.button.hover.image.color: $FG
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: $ACCENT
window.inactive.button.pressed.image.color: #ffffff
osd.bg: flat solid
osd.bg.color: $BG2
osd.border.color: $ACCENT
osd.border.width: 1
osd.label.bg: parentrelative
osd.label.text.color: $FG
EOF

  # --- panel / taskbar (tint2) ---
  cat > "$HOME/.config/tint2/tint2rc" <<EOF
# NEXUS taskbar (generated by nexus-theme)
# 1: panel
rounded = 0
border_width = 1
border_sides = T
background_color = $BG2 96
border_color = $ACCENT 80

# 2: task (normal)
rounded = 4
border_width = 0
background_color = $BG 0
border_color = $BG 0

# 3: task (active)
rounded = 4
border_width = 1
border_sides = TBLR
background_color = $ACCENT2 55
border_color = $ACCENT 100

panel_items = LTSC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
autohide = 0

launcher_padding = 4 2 6
launcher_background_id = 0
launcher_icon_size = 26
launcher_item_app = /usr/share/applications/nexus-start.desktop
launcher_item_app = /usr/share/applications/nexus-terminal.desktop
launcher_item_app = /usr/share/applications/nexus-files.desktop
launcher_item_app = /usr/share/applications/nexus-control.desktop

taskbar_mode = single_desktop
taskbar_padding = 6 2 4
taskbar_background_id = 0
task_text = 1
task_icon = 1
task_centered = 1
task_maximum_size = 180 30
task_padding = 8 4 4
task_font = DejaVu Sans 9
task_font_color = $FG 90
task_active_font_color = #ffffff 100
task_background_id = 2
task_active_background_id = 3

systray_padding = 4 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20

time1_format = %H:%M
time1_font = DejaVu Sans Bold 10
time2_format = %a %d %b
time2_font = DejaVu Sans 8
clock_font_color = $FG 100
clock_padding = 10 0
clock_background_id = 0
EOF

  # --- wallpaper ---
  if [ -f "$NEXUS_SHARE/wallpapers/$name.png" ]; then
    ln -sf "$NEXUS_SHARE/wallpapers/$name.png" "$CFG/wallpaper.png"
  else
    rm -f "$CFG/wallpaper.png"
  fi

  # --- live reload if a desktop is running ---
  if [ -n "${DISPLAY:-}" ]; then
    xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
    openbox --reconfigure 2>/dev/null || true
    if [ -f "$CFG/wallpaper.png" ]; then
      feh --bg-fill "$CFG/wallpaper.png" 2>/dev/null || true
    else
      xsetroot -solid "$BG" 2>/dev/null || true
    fi
    pkill -x tint2 2>/dev/null || true
    (tint2 >/dev/null 2>&1 &)
  fi
  echo "Theme '$name' applied. (New terminals pick up the new colours.)"
}

usage() {
  cat <<EOF
nexus theme <command>
  list                 show available themes
  current              show the active theme
  apply <name>         apply a theme (also: nexus theme set <name>)
  export <name> [file] copy a theme file out so you can share it
  import <file.conf>   add a theme file to ~/.config/nexus/themes
EOF
}

cmd="${1:-list}"
[ $# -gt 0 ] && shift
case "$cmd" in
  list|ls) list_themes ;;
  current) cat "$CFG/theme" 2>/dev/null || echo neon ;;
  apply|set) [ $# -ge 1 ] || { usage; exit 1; }; apply_theme "$1" ;;
  export)
    [ $# -ge 1 ] || { usage; exit 1; }
    src=$(find_theme "$1") || { echo "unknown theme: $1" >&2; exit 1; }
    cp "$src" "${2:-./$1.conf}"; echo "Exported to ${2:-./$1.conf}" ;;
  import)
    [ $# -ge 1 ] && [ -f "$1" ] || { usage; exit 1; }
    mkdir -p "$USR_THEMES"; cp "$1" "$USR_THEMES/"; echo "Imported $(basename "$1")" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
